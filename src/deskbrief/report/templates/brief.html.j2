{#- Email-safe layout (spec 9.1): tables, inline CSS only, no script, no style block, no external
    resources. Every string below comes from the BriefModel (P-009: labels are the model's, this
    file never says what a value "is"). Autoescape is on. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ m.title }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background:#ffffff;border:1px solid #dcdfe4;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1b1f24;">
<tr>
<td style="padding:14px 16px 4px 16px;font-size:18px;font-weight:bold;">{{ m.title }}</td>
<td align="right" style="padding:14px 16px 4px 16px;font-size:13px;color:{{ health_color }};white-space:nowrap;">&#9679; {{ m.health.text }}</td>
</tr>
<tr><td colspan="2" style="padding:4px 16px 12px 16px;font-size:14px;">{{ m.headline.text }}</td></tr>
</table>
{% for s in m.sections %}
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background:#ffffff;border:1px solid #dcdfe4;border-top:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1b1f24;">
<tr style="background:#eef0f3;">
<th align="left" style="padding:6px 16px;font-size:12px;letter-spacing:1px;">{{ s.title|upper }}</th>
<th align="right" style="padding:6px 6px;font-size:12px;">last</th>
<th align="right" style="padding:6px 6px;font-size:12px;">chg</th>
<th align="right" style="padding:6px 6px;font-size:12px;">as of (ET)</th>
<th align="left" style="padding:6px 16px 6px 8px;font-size:12px;">tier</th>
</tr>
{% for r in s.rows %}
<tr>
<td style="padding:6px 16px;border-top:1px solid #eef0f3;">{{ r.label }}
{%- if r.available and r.basis %}<br><span style="font-size:11px;color:#5b6470;">chg since {{ r.basis }}</span>{% endif %}
{%- for q in r.qualifiers %}<br><span style="font-size:11px;color:#8a5a00;">{{ q }}</span>{% endfor %}</td>
{% if r.available %}
<td align="right" style="padding:6px;border-top:1px solid #eef0f3;white-space:nowrap;">{{ r.value_text }}</td>
<td align="right" style="padding:6px;border-top:1px solid #eef0f3;white-space:nowrap;">{{ r.change_text }}</td>
<td align="right" style="padding:6px;border-top:1px solid #eef0f3;white-space:nowrap;">{{ r.as_of_text }}</td>
<td style="padding:6px 16px 6px 8px;border-top:1px solid #eef0f3;white-space:nowrap;">{{ r.tier_glyph }} {{ r.tier_name }}</td>
{% else %}
<td colspan="4" align="right" style="padding:6px 16px;border-top:1px solid #eef0f3;color:#8a5a00;">{{ r.value_text }}</td>
{% endif %}
</tr>
{% endfor %}
</table>
{% endfor %}
{% if m.notable %}
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background:#ffffff;border:1px solid #dcdfe4;border-top:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1b1f24;">
<tr style="background:#eef0f3;"><th align="left" style="padding:6px 16px;font-size:12px;letter-spacing:1px;">NOTABLE</th></tr>
{% for n in m.notable %}
<tr><td style="padding:5px 16px;border-top:1px solid #eef0f3;">&bull; {{ n.text }}</td></tr>
{% endfor %}
</table>
{% endif %}
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background:#ffffff;border:1px solid #dcdfe4;border-top:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1b1f24;">
<tr style="background:#eef0f3;"><th align="left" style="padding:6px 16px;font-size:12px;letter-spacing:1px;">DATA HEALTH</th></tr>
<tr><td style="padding:5px 16px;border-top:1px solid #eef0f3;color:{{ health_color }};">{{ m.health.text }}</td></tr>
{% for h in m.health.summary.sources if h.status != "ok" %}
<tr><td style="padding:5px 16px;border-top:1px solid #eef0f3;">{{ h.source }}: {{ h.status }} ({{ h.n_failed }} of {{ h.n_fetches }} fetches failed)</td></tr>
{% endfor %}
<tr style="background:#eef0f3;"><th align="left" style="padding:6px 16px;font-size:12px;letter-spacing:1px;">KNOWN LIMITS TODAY</th></tr>
{% for k in m.known_limits %}
<tr><td style="padding:5px 16px;border-top:1px solid #eef0f3;">&bull; {{ k.text }}</td></tr>
{% else %}
<tr><td style="padding:5px 16px;border-top:1px solid #eef0f3;">none recorded</td></tr>
{% endfor %}
</table>
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#5b6470;">
<tr><td style="padding:10px 16px 2px 16px;">{{ legend }}</td></tr>
<tr><td style="padding:2px 16px 16px 16px;">{{ footer }}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
