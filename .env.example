# Copy to .env (gitignored) and fill in. Never commit .env. Never paste values into chat.
# Upload all at once to GitHub Actions:  gh secret set -f .env -R allenvarghese05/desk-brief

# --- Market data (H1) ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=

# --- Cloudflare R2 (H2) ---
R2_ACCOUNT_ID=
R2_BUCKET=deskbrief-data
# token "deskbrief-ci-writer" (Object Read & Write, this bucket only) — used by GitHub Actions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# token "deskbrief-dashboard-reader" (Object Read only) — used by the dashboard
R2_READER_ACCESS_KEY_ID=
R2_READER_SECRET_ACCESS_KEY=

# --- Monitoring (H4) ---
HEALTHCHECK_URL_MORNING=
HEALTHCHECK_URL_EOD=

# --- Email (H5) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# comma-separated
REPORT_RECIPIENTS=

# --- Runtime switches (not secrets) ---
DESKBRIEF_STORAGE_BACKEND=local   # local | r2
DESKBRIEF_DISPLAY_MODE=local      # local | hosted
